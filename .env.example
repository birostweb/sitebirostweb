# Variables à définir dans Dokploy (onglet Environment de l'app birostweb).
# NE PAS committer de vraies valeurs. En prod, Dokploy les injecte dans l'environnement.
# Ce sont les MÊMES identifiants SMTP que ton portfolio (boîte OVH contact@theo-birost.fr).

SMTP_HOST=pro2.mail.ovh.net
SMTP_USERNAME=contact@theo-birost.fr
SMTP_PASSWORD=xxxxxxxxxxxx
SMTP_PORT=587
SMTP_SECURE=tls

# Secret aléatoire pour signer le jeton anti-spam du formulaire (HMAC).
# Génère-en un avec :  openssl rand -hex 32
CONTACT_FORM_SECRET=change-moi-par-une-longue-chaine-aleatoire

# --- Garde-fous du formulaire (optionnels) ---
# Kill-switch : mets "1" pour couper l'envoi du formulaire immédiatement (sans redéploiement).
CONTACT_FORM_DISABLED=0
# Plafond global d'e-mails sur 24 h glissantes (toutes IP confondues). Défaut : 30.
CONTACT_FORM_DAILY_CAP=30
# Dossier des logs du formulaire (défaut : /tmp, éphémère). Monte un volume pour les garder.
# CONTACT_LOG_DIR=/var/log/contact
